# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/vr_therapy_dashboard

# Server Configuration
PORT=5000

# OpenAI API Key (for LLM scene generation)
OPENAI_API_KEY=your_openai_api_key_here

# Unity HTTP Listener URL
UNITY_SERVER_URL=http://localhost:8080

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Upload directory for preview images
UPLOAD_DIR=./uploads/previews
