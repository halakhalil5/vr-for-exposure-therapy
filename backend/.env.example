# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/vr_therapy_dashboard

# Server Configuration
PORT=5000

# OpenAI API Key (optional, used by existing scene generation endpoint)
OPENAI_API_KEY=

# OpenRouter API Key (required for /api/ai-placement)
OPENROUTER_API_KEY=

# Optional OpenRouter headers
OPENROUTER_HTTP_REFERER=
OPENROUTER_X_TITLE=

# Unity HTTP Listener URL
UNITY_SERVER_URL=http://localhost:8080

# CORS Origins (comma-separated, includes local frontend + Unity local testing)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080

# Upload directory for preview images
UPLOAD_DIR=./uploads/previews
